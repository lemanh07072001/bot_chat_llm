PORT=3002
MONGODB_URI=mongodb://localhost:27017/chat_center
# Admin panel runs on 3000, widget dev playground on 5173. Widget endpoints
# (/api/widget/*) answer any origin regardless — see src/cors.middleware.ts.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# How many reverse proxies sit in front of the api. 0 (the default) means the
# api is reached directly and X-Forwarded-For is ignored, which is what keeps
# the per-IP rate limits honest; behind nginx this is 1.
TRUST_PROXY=0
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
# How long an anonymous visitor keeps their chat session.
VISITOR_JWT_EXPIRES_IN=7d
PUBLIC_API_URL=http://localhost:3002/api
# The api serves the bundle itself at /v1/widget.js, so the embed snippet is
# derived from PUBLIC_API_URL and WIDGET_URL only needs setting when the bundle
# is published somewhere else (a CDN).
# WIDGET_URL=https://cdn.example.com/v1/widget.js
# Where the built bundle is read from. The default resolves to ../widget/dist,
# which is the dev layout; a container sets this to wherever it copied it.
# WIDGET_ASSET_DIR=../widget/dist
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Chat Center <no-reply@example.com>"

# Cloudflare R2: server-side only. Never prefix with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public custom domain or enabled r2.dev URL, NOT the S3 API endpoint.
R2_PUBLIC_BASE_URL=

# Local site logos (default storage). Relative to the API working directory.
SITE_IMAGE_DIR=uploads/site-images

# Chat/ticket image attachments: stored in R2 (public objects) when all five
# R2_* keys above are set, otherwise on local disk and served by
# GET /api/attachments/:file. Relative to the API working directory.
ATTACHMENT_DIR=uploads/attachments

# Separate Socket.IO service and private Redis event bus
REDIS_URL=redis://127.0.0.1:6379
REALTIME_CHANNEL=chat-center:realtime:v1
PUBLIC_REALTIME_URL=http://localhost:3003

# Telegram two-way bridge (API only). Generate with: openssl rand -hex 32
# Keep this key stable and back it up separately; encrypted bot tokens need it.
TELEGRAM_ENCRYPTION_KEY=
TELEGRAM_WORKER_ENABLED=true

# Missed-chat sweep: minutes a visitor may wait before staff are told.
MISSED_CHAT_MINUTES=5
# Admin panel base url, used for the deep links in notification mails.
ADMIN_URL=http://localhost:3000

# Web Push (VAPID): generate once with `npx web-push generate-vapid-keys --json`. Same pair in api and realtime.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com